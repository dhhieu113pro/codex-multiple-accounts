<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodexMultipleAccounts.App.MainWindow"
        Title="Codex Multiple Accounts"
        Width="1120" Height="760" MinWidth="900" MinHeight="600">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="20,16" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="Codex Multiple Accounts" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="Run isolated Codex profiles in parallel without swapping your global account." Opacity="0.65" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="320,12,*" Margin="16">
      <Border Padding="16" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
          <TextBlock Text="Profiles" FontSize="18" FontWeight="SemiBold" />

          <StackPanel Grid.Row="1" Margin="0,14,0,12" Spacing="8">
            <TextBox Watermark="New profile name" Text="{Binding NewProfileName, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,8,*">
              <Button Content="Create" Command="{Binding CreateProfileCommand}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="2" Content="Import ~/.codex" Command="{Binding ImportDefaultCommand}" HorizontalAlignment="Stretch" />
            </Grid>
          </StackPanel>

          <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="10" Margin="0,2" CornerRadius="8">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <Border Grid.Column="1" IsVisible="{Binding IsGloballyActive}" Padding="7,2" CornerRadius="8"
                              Background="{DynamicResource AccentControlFillColorDefaultBrush}">
                        <TextBlock Text="Global" FontSize="11" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding CodexHome}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="8">
            <TextBox Watermark="Rename selected profile" Text="{Binding RenameProfileName, Mode=TwoWay}" />
            <Button Content="Rename" Command="{Binding RenameSelectedCommand}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <Button Grid.Row="4" Margin="0,8,0,0" Content="Delete profile" Command="{Binding DeleteSelectedCommand}" HorizontalAlignment="Stretch" />
        </Grid>
      </Border>

      <Border Grid.Column="2" Padding="18" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorderMidBrush}" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue=Select a profile}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Each isolated launch receives only this profile's CODEX_HOME." Opacity="0.65" />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,16,0,0" ColumnDefinitions="Auto,12,*">
            <TextBlock Text="Working directory" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding WorkingDirectory, Mode=TwoWay}" />
          </Grid>

          <StackPanel Grid.Row="2" Margin="0,14,0,14" Spacing="10">
            <Grid ColumnDefinitions="*,10,*,10,*">
              <Button Classes="accent" Content="Launch isolated" Command="{Binding LaunchIsolatedCommand}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="2" Content="Open externally" Command="{Binding OpenExternallyCommand}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="4" Content="Activate globally" Command="{Binding ActivateGloballyCommand}" HorizontalAlignment="Stretch" />
            </Grid>
            <TextBlock Text="Activate globally replaces the default ~/.codex only after creating a recoverable backup. Isolated launches never change it."
                       TextWrapping="Wrap" FontSize="12" Opacity="0.65" />
          </StackPanel>

          <Border Grid.Row="3" CornerRadius="8" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
              <Grid Margin="12,8" ColumnDefinitions="*,Auto">
                <TextBlock Text="Sessions" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Windows: embedded terminal · Linux/macOS: external terminal fallback" FontSize="11" Opacity="0.55" />
              </Grid>
              <TabControl Grid.Row="1" x:Name="TerminalTabs" Margin="8" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Padding="16,8" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
