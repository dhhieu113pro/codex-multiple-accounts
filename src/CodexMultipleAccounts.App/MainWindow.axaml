<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CodexMultipleAccounts.App.MainWindow" Width="1100" Height="700" Title="Codex Multiple Accounts"><Grid ColumnDefinitions="300,*" RowDefinitions="Auto,*"><Border Grid.ColumnSpan="2" Padding="20,14"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Codex Multiple Accounts" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Parallel isolated CODEX_HOME sessions" VerticalAlignment="Center" Opacity=".6"/></StackPanel></Border><Border Grid.Row="1" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top" Spacing="8"><Button Content="+ New profile" Command="{Binding CreateCommand}"/><Button Content="Import current Codex" Command="{Binding ImportCommand}"/></StackPanel><ListBox Margin="0,12,0,0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding CodexHome}" FontSize="11" Opacity=".55" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><Grid Grid.Row="1" Grid.Column="1" Margin="18" RowDefinitions="Auto,Auto,*"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Launch embedded" Command="{Binding LaunchCommand}"/><Button Content="Open externally" Command="{Binding ExternalCommand}"/><Button Content="Activate globally" Command="{Binding ActivateCommand}"/></StackPanel><TextBlock Grid.Row="1" Margin="0,12" Text="{Binding Status}"/><TabControl Grid.Row="2" ItemsSource="{Binding Sessions}"><TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></TabControl.ItemTemplate><TabControl.ContentTemplate><DataTemplate><Grid RowDefinitions="*,Auto"><TextBox Grid.Row="0" Text="{Binding Output}" AcceptsReturn="True" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" TextWrapping="NoWrap"/><Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="*,Auto"><TextBox Grid.Column="0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Watermark="Type input for Codex…"/><Button Grid.Column="1" Margin="8,0,0,0" Content="Send" Command="{Binding SendCommand}"/></Grid></Grid></DataTemplate></TabControl.ContentTemplate></TabControl></Grid></Grid></Window>
