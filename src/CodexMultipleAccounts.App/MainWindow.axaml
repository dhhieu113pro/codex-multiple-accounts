<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodexMultipleAccounts.App.MainWindow"
        x:Name="RootWindow"
        Width="1460"
        Height="880"
        MinWidth="1050"
        MinHeight="680"
        Title="Codex Multiple Accounts">
  <Grid ColumnDefinitions="150,410,*">
    <Border Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="9" Margin="4,4,4,16">
            <Border Width="28" Height="28" CornerRadius="8" Background="#6C3BF5">
              <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
            </Border>
            <TextBlock Text="Codex" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
          </StackPanel>

          <Button Classes="nav active" Content="♙  Accounts"/>
          <Button Classes="nav" Content="▣  Sessions" IsEnabled="False"/>
          <Button Classes="nav" Content="▥  Usage" IsEnabled="False"/>
          <Button Classes="nav" Content="⚙  Settings" IsEnabled="False"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,4">
          <Button Classes="nav" Content="▤  Documentation" IsEnabled="False"/>
          <Button Classes="nav" Content="ⓘ  About" IsEnabled="False"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Column="1"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="16">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Classes="sectionTitle" Text="Accounts"/>
            <TextBlock Classes="muted" Margin="0,3,0,0" FontSize="12" Text="Manage your Codex accounts and run them in parallel."/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
            <Button Classes="subtle" Content="Import" Command="{Binding ImportCommand}"/>
            <Button Classes="primary" Content="＋ Add Account" Command="{Binding CreateCommand}"/>
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ListBox ItemsSource="{Binding ProfileCards}"
                   SelectedItem="{Binding SelectedProfileCard}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="card">
                  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="11">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Accent}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/>
                          <Border IsVisible="{Binding IsGloballyActive}" Background="#167A59" CornerRadius="8" Padding="7,2">
                            <TextBlock Text="Active (Global)" FontSize="10" Foreground="#C7FFE9"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="12"/>
                        <TextBlock Classes="muted" Text="{Binding CodexHome}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="⋯" FontSize="18" Classes="muted" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="92,*,42" RowDefinitions="Auto,Auto" RowSpacing="7" ColumnSpacing="8">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="5-hour limit" FontSize="12"/>
                      <ProgressBar Grid.Row="0" Grid.Column="1" Classes="usage" Minimum="0" Maximum="100" Value="{Binding FiveHourPercent}" Foreground="{Binding Accent}"/>
                      <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding FiveHourLabel}" FontSize="12" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Weekly limit" FontSize="12"/>
                      <ProgressBar Grid.Row="1" Grid.Column="1" Classes="usage" Minimum="0" Maximum="100" Value="{Binding WeeklyPercent}" Foreground="{Binding Accent}"/>
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WeeklyLabel}" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*,Auto" ColumnSpacing="7">
                      <Button Grid.Column="0"
                              Classes="primary"
                              Content="▶  Launch"
                              Command="{Binding #RootWindow.DataContext.LaunchProfileCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Grid.Column="1"
                              Classes="subtle"
                              Content="↗  Set Global"
                              Command="{Binding #RootWindow.DataContext.ActivateProfileCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Grid.Column="2"
                              Classes="subtle"
                              Content="⌘  External"
                              Command="{Binding #RootWindow.DataContext.ExternalProfileCommand}"
                              CommandParameter="{Binding}"/>
                      <Button Grid.Column="3" Classes="subtle" Content="⋯" IsEnabled="False" MinWidth="40"/>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="{DynamicResource PanelAltBrush}" CornerRadius="8">
          <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" FontSize="11"/>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="2" Margin="12" RowDefinitions="*">
      <TabControl ItemsSource="{Binding Sessions}"
                  SelectedItem="{Binding SelectedSession}"
                  Background="Transparent"
                  BorderThickness="0">
        <TabControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="7" Margin="5,1">
              <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
              <TextBlock Text="×" Classes="muted" Margin="7,0,0,0"/>
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>

        <TabControl.ContentTemplate>
          <DataTemplate>
            <Border Classes="panel" Margin="0,4,0,0">
              <Grid RowDefinitions="54,*,Auto,42">
                <Border Grid.Row="0" Background="{DynamicResource PanelAltBrush}" Margin="1" Padding="12,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Border Width="28" Height="28" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text=">_" FontFamily="Cascadia Mono,Consolas" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                      </Border>
                      <TextBlock Text="{Binding CodexHome}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                      <Button Classes="subtle" Content="⛶  Split" IsEnabled="False"/>
                      <Button Classes="subtle" Content="♲" IsEnabled="False" MinWidth="40"/>
                      <Button Classes="subtle" Content="⋯" IsEnabled="False" MinWidth="40"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBox Grid.Row="1"
                         Text="{Binding Output}"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         FontFamily="Cascadia Mono,Consolas"
                         FontSize="13"
                         TextWrapping="NoWrap"
                         Background="{DynamicResource TerminalBrush}"
                         Foreground="#EAF0F7"
                         BorderThickness="0"
                         Padding="14"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                <Border Grid.Row="2" Background="{DynamicResource TerminalBrush}" Padding="12,6,12,10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="Type input for Codex…"
                             FontFamily="Cascadia Mono,Consolas"
                             Background="#0C1118"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="#EAF0F7"/>
                    <Button Grid.Column="1" Margin="8,0,0,0" Classes="primary" Content="Send ↵" Command="{Binding SendCommand}"/>
                  </Grid>
                </Border>

                <Border Grid.Row="3" Background="{DynamicResource PanelAltBrush}" Padding="12,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding StartedAtText}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                      <Border Width="8" Height="8" CornerRadius="4" Background="#24C98A" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding CodexHomeText}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Grid>
  </Grid>
</Window>
